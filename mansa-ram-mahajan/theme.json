{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1440px"
    },
    "color": {
      "custom": true,
      "customDuotone": false,
      "customGradient": true,
      "palette": [
        {
          "name": "Primary Crimson",
          "slug": "primary",
          "color": "#C42B59"
        },
        {
          "name": "Primary Hover",
          "slug": "primary-hover",
          "color": "#A01D44"
        },
        {
          "name": "Onyx Black",
          "slug": "secondary",
          "color": "#1A1A1A"
        },
        {
          "name": "Heritage Gold",
          "slug": "gold",
          "color": "#D4AF37"
        },
        {
          "name": "Warm Ivory",
          "slug": "bg-light",
          "color": "#FAF8F5"
        },
        {
          "name": "Pure White",
          "slug": "white",
          "color": "#FFFFFF"
        },
        {
          "name": "Muted Gray",
          "slug": "muted",
          "color": "#666666"
        },
        {
          "name": "Warm Border",
          "slug": "border",
          "color": "#EAE6E1"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fontFamilies": [
        {
          "fontFamily": "'Playfair Display', Georgia, serif",
          "name": "Playfair Display",
          "slug": "serif"
        },
        {
          "fontFamily": "'Outfit', 'Plus Jakarta Sans', sans-serif",
          "name": "Outfit",
          "slug": "sans"
        }
      ],
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "0.85rem"
        },
        {
          "name": "Normal",
          "slug": "normal",
          "size": "1rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1.25rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "1.75rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "2.5rem"
        },
        {
          "name": "Hero",
          "slug": "hero",
          "size": "3.5rem"
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw", "vh"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text": "var(--wp--preset--color--secondary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--normal)",
      "lineHeight": "1.6"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--hero)",
          "fontWeight": "600"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--x-large)",
          "fontWeight": "600"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--serif)",
          "fontSize": "var(--wp--preset--font-size--large)",
          "fontWeight": "500"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "radius": "4px"
        }
      }
    }
  }
}
